    <style>
      svg {border: 1px solid #cccccc; padding: 0 0 0 0; margin: 0; background: #ffffff;}
      rect {cursor: pointer;}
      rect.bar {fill: #aaffaa; stroke: #888888; stroke-width: 0.75;}
      *.hbar {fill: #aaffaa}
      *.vbar {fill: #eeeeee}
      polygon {fill: #aaaaff}
      *.cw {fill: #ffcccc; stroke-width: 0;}
      *.sel {fill: #ff4444;}
      *.todo {fill: #4cb1c5;}
      *.test {fill: #4cb1c5;}
      *.target {fill: #4cb1c5;}
    </style>

	<script type="text/javascript" src="?spath=myGanttChart.js">// /pie/examples/GanttChart/ </script>
        <div id="ui">
          <div id="content">
    
    <svg version="1.1" baseProfile="full" id="gantt_diagram"/>

